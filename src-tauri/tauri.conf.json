{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "canoPi",
  "productName": "canoPi",
  "version": "0.0.1",
  "identifier": "app.canopi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "canoPi",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#101f25",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "canoPi Project",
    "copyright": "Copyright (c) 2026 canoPi Project",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": {
      "resources/engine/cnp-engine.exe": "engine/cnp-engine.exe",
      "resources/licenses/LICENSE-OMP.txt": "licenses/LICENSE-OMP.txt",
      "resources/licenses/THIRD-PARTY-NOTICES-OMP.txt": "licenses/THIRD-PARTY-NOTICES-OMP.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "tsp": true,
      "signCommand": null,
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
